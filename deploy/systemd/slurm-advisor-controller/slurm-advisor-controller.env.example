# This is a systemd EnvironmentFile, not a shell script. Replace values for the
# local Slurm installation and Heimdall API gateway before starting the unit.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SLURM_CONF=/etc/slurm/slurm.conf
# Uncomment only when the Slurm client binaries do not carry a usable RUNPATH.
# LD_LIBRARY_PATH=/path/to/slurm/lib

HEIMDALL_ENDPOINT=
SLURM_ADVISOR_LOG_LEVEL=info
SLURM_ADVISOR_POLL_INTERVAL=15s
SLURM_EXEC_TIMEOUT=5s
SLURM_ADVISOR_LOG_METADATA_REFRESH_INTERVAL=5m
SLURM_ADVISOR_LOG_METADATA_ENRICHMENT_TIMEOUT=2s
SLURM_ADVISOR_JOB_UPSERT_WORKER_POOL_SIZE=8
SLURM_ADVISOR_ACCOUNTING_WORKER_POOL_SIZE=8
SLURM_ADVISOR_ACCOUNTING_TIMEOUT=5m
# Shared per-tick budget; unfinished recovery resumes on later ticks.
SLURM_ADVISOR_FAILED_JOB_RECOVERY_TIMEOUT=30s
# Select logging (also used for empty values) or gateway.
SLURM_ADVISOR_AUDIT_TRAIL_DESTINATION=logging
SLURM_ADVISOR_AUDIT_TRAIL_MAX_BATCH_SIZE=100
SLURM_ADVISOR_AUDIT_TRAIL_BUFFER_SIZE=1000
SLURM_ADVISOR_AUDIT_TRAIL_FLUSH_INTERVAL=30s
SLURM_ADVISOR_LOG_LINKS_ENABLED=false
# Enabling this option authorizes filesystem writes independently from
# scheduler-action mode. Install the matching systemd hardening drop-in first.
# The destination must not equal, overlap, contain, be contained by, or alias
# any source root through a bind mount or another backing-store mapping.
# SLURM_ADVISOR_LOG_LINKS_DESTINATION=/var/lib/heimdall-oss/log-links
# Source writers must be trusted not to substitute symlinks; a following
# collector must expose no unrelated mounts or secrets that such a link can reach.
# SLURM_ADVISOR_LOG_LINKS_SOURCE_ROOTS_JSON='["/var/log/slurm/jobs"]'
# SLURM_ADVISOR_LOG_LINKS_APPLICATION_PATTERNS_JSON='["^app-{job_id}[.]log$","^worker-{job_id}[.]log$"]'
# SLURM_ADVISOR_LOG_LINKS_SCAN_INTERVAL=1m
# SLURM_ADVISOR_LOG_LINKS_CLEANUP_INTERVAL=1h
# SLURM_ADVISOR_LOG_LINKS_RETENTION=24h
# SLURM_ADVISOR_LOG_LINKS_SCAN_TIMEOUT=5s
# SLURM_ADVISOR_LOG_LINKS_MAX_PATH_LENGTH=4096
# SLURM_ADVISOR_LOG_LINKS_MAX_PATHS_PER_SYNC=4096
# SLURM_ADVISOR_LOG_LINKS_MAX_PATTERNS=32
# SLURM_ADVISOR_LOG_LINKS_MAX_SCAN_DIRECTORIES=64
# SLURM_ADVISOR_LOG_LINKS_MAX_ENTRIES_PER_DIRECTORY=4096
# SLURM_ADVISOR_LOG_LINKS_MAX_MATCHES_PER_SCAN=512
# SLURM_ADVISOR_LOG_LINKS_MAX_OWNED_LINKS=16384
SLURM_ADVISOR_ADVICE_LOOP_TIMEOUT=15s
SLURM_ADVISOR_ADVICE_ITEM_TIMEOUT=30s
SLURM_ADVISOR_REQUEUE_HOLD_DELAY=1s
# Opt-in rollback: requeue before Advice can bypass backend retry/checkpoint stops.
SLURM_ADVISOR_ENABLE_EAGER_REQUEUE=false
# End-time lookback for bootstrap eager recovery of finished failures.
# Active attempts and unresolved Advice are retained regardless of age.
SLURM_ADVISOR_BOOTSTRAP_FAILURE_LOOKBACK=30m
SLURM_ADVISOR_ENVIRONMENT=replace-me
# Temporary initial internal rollout only; deprecated soon, removable without notice.
# Comma-separated exact usernames, e.g. alice,bob; does not filter monitoring.
# Without explicit job mode: listed users act, others observe. Explicit mode wins.
# Empty uses SLURM_ADVISOR_MODE. Acknowledgement and other safety gates still apply.
# Prefer default observe; default act plus a list logs a bootstrap warning.
# Synchronize watchdog JOB_DEFAULT_MODE, JOB_ACTIONS_ACKNOWLEDGED, and USER_ALLOWLIST
# with this service mode, acknowledgement, and list. Restart both to apply.
SLURM_ADVISOR_USER_ALLOWLIST=
SLURM_ADVISOR_PARTITION_ALLOWLIST=replace-me
SLURM_ADVISOR_VERSIONED_SQUEUE_JSON=true
SLURM_ADVISOR_UPDATE_ELIGIBLE_TIME_AFTER_REQUEUE=false
SLURM_ADVISOR_METRICS_ENABLED=true
SLURM_ADVISOR_METRICS_ADDR=127.0.0.1:19091

# Omit SLURM_ADVISOR_SERVICE_ACCOUNT_TOKEN_PATH when the gateway is
# unauthenticated. An explicitly empty value is invalid.
# SLURM_ADVISOR_SERVICE_ACCOUNT_TOKEN_PATH=/etc/heimdall-oss/gateway-token

# The unit pins observe mode and acknowledgement=false in ExecStart. Setting
# those safety variables in this file cannot enable scheduler mutations.
