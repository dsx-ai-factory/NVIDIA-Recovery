# This is a systemd EnvironmentFile, not a shell script. Replace values for the
# local Slurm installation before starting the unit.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SLURM_CONF=/etc/slurm/slurm.conf
# Uncomment only when the Slurm client binaries do not carry a usable RUNPATH.
# LD_LIBRARY_PATH=/path/to/slurm/lib

SLURM_WATCHDOG_POLL_INTERVAL=15s
SLURM_WATCHDOG_ENVIRONMENT_PATTERN=unspecified
# Temporary initial internal rollout only; deprecated soon, removable without notice.
# Match SLURM_ADVISOR_USER_ALLOWLIST in the SAC env file, e.g. alice,bob.
# Without an explicit job mode: listed users act, unlisted users observe.
# An empty list uses the SAC job default. Restart both services after changes.
SLURM_WATCHDOG_USER_ALLOWLIST=
# Mirror SAC mode and acknowledgement independently of watchdog mode/safety.
SLURM_WATCHDOG_JOB_DEFAULT_MODE=observe
SLURM_WATCHDOG_JOB_ACTIONS_ACKNOWLEDGED=false
SLURM_WATCHDOG_RELEASE_TIMEOUT=10m
SLURM_WATCHDOG_CLEANUP_GRACE_PERIOD=10m
SLURM_WATCHDOG_SLURM_EXEC_TIMEOUT=5s
SLURM_WATCHDOG_PARTITION_ALLOWLIST=replace-me
SLURM_WATCHDOG_VERSIONED_SQUEUE_JSON=true
SLURM_WATCHDOG_LOG_LEVEL=info
SLURM_WATCHDOG_METRICS_ENABLED=true
SLURM_WATCHDOG_METRICS_ADDR=127.0.0.1:19092
# Select logging (also used for empty values) or gateway.
SLURM_WATCHDOG_AUDIT_TRAIL_DESTINATION=logging
# Required for destination=gateway.
# SLURM_WATCHDOG_AUDIT_GATEWAY_ENDPOINT=heimdall-api-gateway-internal:9090
# SLURM_WATCHDOG_SERVICE_ACCOUNT_TOKEN_PATH=/var/run/secrets/heimdall/service-account-token
SLURM_WATCHDOG_AUDIT_TRAIL_MAX_BATCH_SIZE=100
SLURM_WATCHDOG_AUDIT_TRAIL_BUFFER_SIZE=1000
SLURM_WATCHDOG_AUDIT_TRAIL_FLUSH_INTERVAL=30s

# The unit pins observe mode and acknowledgement=false in ExecStart. Setting
# those safety variables in this file cannot enable scheduler mutations.
