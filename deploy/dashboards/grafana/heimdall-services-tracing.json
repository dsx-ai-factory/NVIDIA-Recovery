{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "panels": [],
      "title": "Recovery outcomes",
      "type": "row"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "id": 2,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 50,
          "query": "{ span:name = \"job.recovery.reconcile\" && span.recovery.outcome = \"applied\" && span.recovery.operation = \"restart\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "description": "Application performed applicable work. This does not prove successful release or durable completion; later convergence is separate.",
      "title": "Applied restart Advice (not completion)",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "id": 3,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 50,
          "query": "{ span:name = \"job.recovery.reconcile\" && span.recovery.terminal = true && span.recovery.outcome = \"skipped\" } | select(span.advice.skip.reason, span.recovery.operation)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "description": "Generation-terminal reconciliation outcomes; missing command completion timing remains unknown.",
      "title": "Terminal skips",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "id": 4,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 50,
          "query": "{ span:name = \"job.recovery.reconcile\" && span.recovery.terminal = true && span.recovery.outcome = \"failed\" && span:status = error }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Terminal failures",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 9},
      "id": 5,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 50,
          "query": "{ span:name = \"job.recovery.reconcile\" && span.recovery.terminal = false && span.recovery.outcome = \"failed\" && span:status = error }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Retryable failed attempts",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 9},
      "id": 6,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 50,
          "query": "{ span:name = \"job.recovery.reconcile\" && span.recovery.terminal = false && span.recovery.outcome = \"planned\" && span.recovery.slo.eligible = false }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Observe-mode plans",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 9},
      "id": 7,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 50,
          "query": "{ span:name = \"job.recovery.reconcile\" && span.recovery.operation = \"dag_release\" && span.recovery.slo.eligible = false }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "DAG Advice applications (SLO excluded)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17},
      "id": 8,
      "panels": [],
      "title": "Recovery trace explorer",
      "type": "row"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 18},
      "id": 9,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "limit": 100,
          "query": "{ span:name =~ \"${operation:regex}\" && resource.service.name =~ \"${service:regex}\" && span.recovery.sequence.id =~ \"${sequence_id:regex}\" && span.job.id =~ \"${job_id:regex}\" } | select(span.recovery.sequence.id, span.recovery.operation, span.recovery.outcome, span.recovery.terminal, span.job.id, span.job.attempt.source, span.job.attempt.target, span.advice.id, span.scheduler.action, span.scheduler.action.outcome)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Recovery spans",
      "type": "table"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
      "gridPos": {"h": 18, "w": 24, "x": 0, "y": 32},
      "id": 10,
      "options": {},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo_datasource}"},
          "query": "${trace_id}",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Trace detail",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 50},
      "id": 11,
      "panels": [],
      "title": "Recovery metrics",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 51},
      "id": 12,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
          "expr": "sum by (operation, trigger_type, outcome) (rate(nvidia_recovery_sequences_total[$__rate_interval]))",
          "legendFormat": "{{operation}} {{trigger_type}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Sequence begin rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 51},
      "id": 13,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
          "expr": "sum by (operation, outcome, terminal) (rate(nvidia_recovery_reconcile_outcomes_total[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} terminal={{terminal}}",
          "refId": "A"
        }
      ],
      "title": "Reconcile outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 51},
      "id": 14,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
          "expr": "sum by (operation, action, outcome) (rate(nvidia_recovery_scheduler_actions_total[$__rate_interval]))",
          "legendFormat": "{{operation}} {{action}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Scheduler action attempts",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 59},
      "id": 15,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(nvidia_recovery_end_to_end_duration_seconds_bucket{operation=\"restart\"}[$__rate_interval])))",
          "legendFormat": "p95 {{operation}}",
          "refId": "A"
        }
      ],
      "title": "Completed restart latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 59},
      "id": 16,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
          "expr": "sum by (source, outcome) (rate(nvidia_recovery_trace_context_total[$__rate_interval]))",
          "legendFormat": "{{source}} {{outcome}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
          "expr": "sum by (operation, action, result) (rate(nvidia_recovery_milestone_reports_total[$__rate_interval]))",
          "legendFormat": "milestone {{operation}} {{action}} {{result}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${prometheus_datasource}"},
          "expr": "sum by (operation, action, outcome, record_result) (rate(nvidia_recovery_milestones_recorded_total[$__rate_interval]))",
          "legendFormat": "recorded {{operation}} {{action}} {{outcome}} {{record_result}}",
          "refId": "C"
        }
      ],
      "title": "Correlation and milestone coverage",
      "type": "timeseries"
    }
  ],
  "preload": false,
  "schemaVersion": 42,
  "tags": ["nvidia-recovery", "tracing"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Tempo datasource",
        "name": "tempo_datasource",
        "options": [],
        "query": "tempo",
        "type": "datasource"
      },
      {
        "current": {},
        "label": "Prometheus datasource",
        "name": "prometheus_datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {"text": "$__all", "value": "$__all"},
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "nvidia-recovery-job-manager,nvidia-recovery-attribution-adapter,nvidia-recovery-slurm-advisor-controller",
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": {"text": "$__all", "value": "$__all"},
        "includeAll": true,
        "label": "Operation span",
        "multi": true,
        "name": "operation",
        "options": [],
        "query": "job.recovery.trigger,job.recovery.attribution,job.recovery.advice,job.recovery.reconcile,job.recovery.scheduler_action,job.recovery.state_check",
        "type": "custom"
      },
      {
        "current": {"text": ".*", "value": ".*"},
        "label": "Recovery sequence ID regex",
        "name": "sequence_id",
        "options": [],
        "query": ".*",
        "type": "textbox"
      },
      {
        "current": {"text": ".*", "value": ".*"},
        "label": "Job ID regex",
        "name": "job_id",
        "options": [],
        "query": ".*",
        "type": "textbox"
      },
      {
        "current": {"text": "", "value": ""},
        "description": "Paste a Trace ID to view its waterfall",
        "label": "Trace ID",
        "name": "trace_id",
        "options": [],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]},
  "timezone": "browser",
  "title": "NVIDIA Recovery Traces",
  "uid": "nvidia-recovery-traces",
  "version": 1
}
