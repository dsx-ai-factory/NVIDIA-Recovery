# Keep this profile independent of the Slurm/Slinky root Tiltfile.
cluster = os.environ.get('KUBERNETES_DEV_CLUSTER', 'nvr-kubernetes-dev')
allow_k8s_contexts('kind-' + cluster)
local_resource(
    'jobset',
    cmd=['bash', './install-jobset.sh'],
    deps=['install-jobset.sh'],
    labels=['infra'],
)

docker_build('advice-operator', '../../..', dockerfile='../../../advice-operator/Dockerfile')
docker_build('mock-advice-gateway', '../../..', dockerfile='Dockerfile.mock-gateway')
k8s_yaml('mock-gateway.yaml')
k8s_resource('mock-advice-gateway', resource_deps=['jobset'], labels=['advice'])

operator_yaml = helm(
    '../../helm/advice-operator',
    name='advice-operator',
    namespace='recovery-dev',
    values=['advice-operator-values.yaml'],
)
k8s_yaml(operator_yaml)
# Associate support objects explicitly so namespace-scoped RBAC and the service
# account wait for the namespace created by the JobSet bootstrap resource.
operator_objects = [
    obj['metadata']['name'] + ':' + obj['kind']
    for obj in decode_yaml_stream(operator_yaml)
    if obj['kind'] not in ['Deployment', 'Service']
]
k8s_resource(
    'advice-operator',
    objects=operator_objects,
    resource_deps=['jobset', 'mock-advice-gateway'],
    labels=['advice'],
)
