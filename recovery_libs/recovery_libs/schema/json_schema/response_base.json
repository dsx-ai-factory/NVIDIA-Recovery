{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ResponseBase",
  "title": "ResponseBase",
  "description": "the result base for actions",
  "type": "object",
  "properties": {
    "result": {
      "type": "string",
      "enum": ["success", "failure"]
    },
    "failure_reason": {
      "type": "string"
    }
  },
  "required": [
    "result"
  ]
}