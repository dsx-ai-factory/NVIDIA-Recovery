{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobSignal",
  "description": "send a user-specified signal to a job identified by id (scancel in slurm)",
  "type": "object",

  "properties": {
    "name": {
      "const": "JobSignal"
    },
    "params": {
      "type": "object",
      "allOf": [
        {
          "$ref": "job_action_params.json#/definitions/base_params"
        }
      ],
      "properties": {
        "signal": {
          "type": "string"
        }
      },
      "required": [
        "signal"
      ]
    }
  },
  "required": [
    "name", "params"
  ]
}