// The singleton application reader owns the shared log-link tree.
// Component offsets persist below --storage.path; source mounts stay read-only.

local.file_match "slurm_logs" {
	path_targets = [
		{
			__address__ = "localhost",
			__path__    = "/home/log-links/**/*.out",
			appName     = "slurm-app-log",
			cluster     = "slurm",
		},
		{
			__address__ = "localhost",
			__path__    = "/home/log-links/**/*.log",
			appName     = "slurm-app-log",
			cluster     = "slurm",
		},
	]
}

loki.process "slurm_logs" {
	forward_to = [loki.write.default.receiver]

	// Legacy standalone names allow a nonnumeric prefix and an optional _date_ suffix.
	// Multiple numeric tokens before that suffix require an explicit identity rule.
	stage.regex {
		expression = "(?:^|/)[^0-9/]*[_-](?P<job_id>\\d+)(?:_date_[^/]*|\\.(?:out|log))$"
		source     = "filename"
	}

	// Preserve the complete job ID from Slurm's standard array log filename.
	// Other numeric-pair filenames need an explicit site-specific identity rule.
	stage.regex {
		expression = "(?:^|/)slurm-(?P<job_id>\\d+_\\d+)\\.(?:out|log)$"
		source     = "filename"
	}

	stage.labels {
		values = {
			job_id = null,
		}
	}
}

loki.source.file "slurm_logs" {
	targets    = local.file_match.slurm_logs.targets
	forward_to = [loki.process.slurm_logs.receiver]
}

loki.write "default" {
	endpoint {
		url = "__LOG_PUSH_URL__"
	}
	external_labels = {}
}
