// The singleton application reader owns the shared log-link tree.
// Component offsets persist below --storage.path; source mounts stay read-only.

local.file_match "slurm_logs" {
	path_targets = [
		{
			__address__ = "localhost",
			__path__    = "/home/log-links/**/*.out",
			appName     = "slurm-app-log",
			cluster     = "slurm",
		},
		{
			__address__ = "localhost",
			__path__    = "/home/log-links/**/*.log",
			appName     = "slurm-app-log",
			cluster     = "slurm",
		},
	]
}

loki.process "slurm_logs" {
	forward_to = [loki.write.default.receiver]

	stage.regex {
		// The generated branch keeps canonical array IDs whole. Legacy date
		// names retain both previously accepted separators.
		expression = "(?:(?:.*/)?[A-Za-z0-9-]{1,64}-[0-9a-f]{16}-a\\d+_|.*[_-])(?P<job_id>\\d+(?:_\\d+)?)_date_.*$"
		source     = "filename"
	}

	stage.regex {
		// Prefer an ordinary numeric suffix over date-like text in the stem.
		// The following timestamp rule corrects date-shaped suffixes.
		expression = "(?:.*)[_-](?P<job_id>\\d+)\\.(?:out|log)$"
		source     = "filename"
	}

	stage.regex {
		// Recognized timestamp names override the ordinary suffix's seconds.
		// The generated prefix keeps a parent_task identity intact.
		expression = "(?:(?:.*/)?[A-Za-z0-9-]{1,64}-[0-9a-f]{16}-a\\d+_|.*[_-])(?P<job_id>\\d+(?:_\\d+)?)_date_\\d{2}-\\d{2}-\\d{2}_time_\\d{2}-\\d{2}-\\d{2}\\.(?:out|log)$"
		source     = "filename"
	}

	stage.labels {
		values = {
			job_id = null,
		}
	}
}

loki.source.file "slurm_logs" {
	targets    = local.file_match.slurm_logs.targets
	forward_to = [loki.process.slurm_logs.receiver]
}

loki.write "default" {
	endpoint {
		url = "__LOG_PUSH_URL__"
	}
	external_labels = {}
}
