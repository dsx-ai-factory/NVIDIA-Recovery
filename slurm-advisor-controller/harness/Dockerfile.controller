ARG BASE_IMAGE=slurm-advisor-controller-slurm-base:dev

FROM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS controller-build

WORKDIR /src
COPY api-gateway ./api-gateway
COPY slurm-advisor-controller ./slurm-advisor-controller

RUN cd slurm-advisor-controller \
    && go build -o /out/slurm-advisor-controller ./cmd/slurm-advisor-controller \
    && go build -o /out/mock-heimdall-gateway ./cmd/mock-heimdall-gateway

FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="slurm-advisor-controller-harness" \
      org.opencontainers.image.description="Controller and mock Heimdall image for the Slurm advisor controller harness"

COPY --from=controller-build --chmod=0755 /out/slurm-advisor-controller /usr/local/bin/slurm-advisor-controller
COPY --from=controller-build --chmod=0755 /out/mock-heimdall-gateway /usr/local/bin/mock-heimdall-gateway
