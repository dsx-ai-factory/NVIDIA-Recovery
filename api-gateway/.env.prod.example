# Configuration for production deploys.

HEIMDALL_INSECURE="false"
HEIMDALL_OIDC_ENABLED="true"
HEIMDALL_JWT_ENABLED="false"

HEIMDALL_OIDC_COOKIE_KEY=""
HEIMDALL_OIDC_SECURE_COOKIE="true"

HEIMDALL_OIDC_PROVIDER_URL="https://issuer.example.com"
HEIMDALL_OIDC_CLIENT_ID="heimdall"
HEIMDALL_OIDC_CLIENT_SECRET=""
HEIMDALL_OIDC_SCOPES="openid,profile,email"
HEIMDALL_OIDC_SUBJECT_CLAIM="sub"
HEIMDALL_OIDC_CLIENT_ID_CLAIM="client_id"
HEIMDALL_OIDC_SCOPES_CLAIM="scope"
HEIMDALL_LOGIN_REDIRECT_URL="https://heimdall.example.com/mission-control/recovery-engine-api/v1/auth/callback"

HEIMDALL_JWT_ISSUER="https://issuer.example.com"
HEIMDALL_JWT_AUDIENCES="heimdall"
HEIMDALL_JWT_JWKS_URL="https://issuer.example.com/.well-known/jwks.json"
HEIMDALL_JWT_SUBJECT_CLAIM="sub"
HEIMDALL_JWT_CLIENT_ID_CLAIM="client_id"
HEIMDALL_JWT_SCOPES_CLAIM="scope"
